{
  "name": "inventa-gestypro",
  "version": "1.0.0",
  "description": "Inventa GestyPro — gestion multi-magasins : inventaires, stocks, caisse, ventes, achats, personnel, rapports et abonnements",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/tout.js",
    "seed": "node -e \"require('./server/seed').reinitialiser();\"",
    "test:exigences": "node tests/exigences.js",
    "test:verification-proprietaire": "node tests/verification-proprietaire.js",
    "test:paiements": "node tests/paiements-securises.js",
    "test:caisse": "node tests/caisse-promotions.js",
    "test:mysql": "node tests/mysql-integration.js",
    "backup:mysql": "node scripts/sauvegarder-mysql.js",
    "db:init": "node scripts/initialiser-mysql.js",
    "test:production": "node tests/production.js",
    "test:cloudflare": "node tests/cloudflare.js && node tests/connexion-interface.mjs && node tests/d1.mjs",
    "cloudflare:check": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "test:d1": "node tests/d1.mjs",
    "test:d1:interface": "node tests/d1-interface.mjs",
    "export:d1": "node scripts/exporter-d1.js",
    "dev:cloudflare": "wrangler dev",
    "db:d1:migrate": "wrangler d1 migrations apply gestion_enterprize --remote",
    "test:connexion": "node tests/connexion-interface.mjs && node tests/d1.mjs"
  },
  "keywords": [
    "gestion",
    "shopping",
    "magasins",
    "stocks",
    "caisse",
    "pos"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.0.14"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
