{
  "name": "inventa-gestypro",
  "version": "1.0.0",
  "description": "Inventa GestyPro — gestion multi-magasins : inventaires, stocks, caisse, ventes, achats, personnel, rapports et abonnements",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/tout.js",
    "seed": "node -e \"require('./server/seed').reinitialiser();\"",
    "test:exigences": "node tests/exigences.js",
    "test:verification-proprietaire": "node tests/verification-proprietaire.js",
    "test:paiements": "node tests/paiements-securises.js",
    "test:caisse": "node tests/caisse-promotions.js",
    "test:netlify": "node tests/netlify-postgres.cjs && node --experimental-strip-types tests/netlify-function.mjs && node tests/netlify-interface.cjs"
  },
  "keywords": [
    "gestion",
    "shopping",
    "magasins",
    "stocks",
    "caisse",
    "pos"
  ],
  "license": "MIT",
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.2",
    "@netlify/identity": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.14",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-kit": "^1.0.0-beta.22",
    "jsdom": "^26.1.0"
  }
}
