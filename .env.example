NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gestion_enterprize
MYSQL_USER=gestion_app
MYSQL_PASSWORD=
JWT_SECRET=
# Uniquement pour une base neuve, sans propriétaire importé :
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Propriétaire
# Derrière un seul proxy HTTPS :
TRUST_PROXY=1
SEED_DEMO=false
# MySQL distant avec certificat vérifié, si demandé par l’hébergeur :
MYSQL_SSL=false
MYSQL_SSL_CA=
# Répertoire à monter sur un disque persistant :
DOCUMENTS_DIR=
APP_URL=https://votre-domaine.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Docker Compose uniquement :
MYSQL_ROOT_PASSWORD=
